# Copy to .env.local for local development. Every variable is optional locally;
# the schema in src/lib/env.ts rejects malformed values at build time.

# Resend API key (re_...). Without it, enquiry forms answer 503 in production
# and only log "not sent" in development.
RESEND_API_KEY=

# Inbox for contact, booking, pilot and sector enquiries. Default: info@nordoravital.com
CONTACT_EMAIL_TO=

# Sender on a domain verified in Resend, e.g. "Nordora Vital <hello@nordoravital.com>".
# Default: Resend's onboarding sender, which only delivers to the Resend account owner.
CONTACT_EMAIL_FROM=

# Public Cal.com booking link for the discovery-call buttons.
NEXT_PUBLIC_CAL_DISCOVERY_URL=https://cal.eu/nordoravital/discovery-call

# PostHog (loaded only after a visitor accepts analytics cookies). The host is added to the CSP.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
